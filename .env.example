# Security & Environment Configuration Template
ENVIRONMENT=production
JWT_SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# Database URL
DATABASE_URL=sqlite:///./rentalyzer.db
