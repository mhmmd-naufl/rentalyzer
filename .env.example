# Security & Environment Configuration Template
ENVIRONMENT=production
JWT_SECRET_KEY=change_this_to_a_random_32_byte_hex_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# Database URL
DATABASE_URL=sqlite:///./rentalyzer.db

# AI Summary (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
# Multi-model fallback (comma-separated, autoswitch berurutan)
# OPENROUTER_MODELS=qwen/qwen3.8-27b:free,apodex/apodex-1.1-mini:free,inclusionai/ling-3.0-flash-sante:free
# Optional (untuk ranking/analytics di openrouter.ai)
# OPENROUTER_SITE_URL=http://localhost:5173
# OPENROUTER_SITE_NAME=Rentalyzer

# Supabase Storage (gambar unit — URL absolut agar tampil di lokal & Vercel)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
